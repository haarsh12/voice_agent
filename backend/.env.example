# LiveKit server and token issuer credentials
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Provider credentials. These never reach the Vite frontend.
CARTESIA_API_KEY=your-cartesia-api-key

# Google Cloud credentials (for STT/TTS/Gemini on Vertex AI)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account.json
# Optional for a service-account key (the project ID is inferred from the key).
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# `global` is the supported endpoint used by the Gemini test and live agent.
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.35

# Verified Knowledge Engine. Keep these server-side and out of source control.
# QDRANT_URL=https://your-internal-qdrant.example
# QDRANT_API_KEY=replace-with-qdrant-api-key
# QDRANT_COLLECTION=sahayak_verified_knowledge
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-004
# KNOWLEDGE_EMBEDDING_BATCH_SIZE=128
# KNOWLEDGE_PDF_MAX_PAGES=300
# KNOWLEDGE_DOCUMENT_PROCESSING_TIMEOUT_SECONDS=120
# KNOWLEDGE_OCR_PROVIDER=google_cloud_vision
# KNOWLEDGE_OCR_MAX_PAGES=20
# KNOWLEDGE_OCR_RENDER_DPI=180

# HTTP server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Account prototype: when DATABASE_URL is omitted in development, Sahayak uses
# a local Git-ignored SQLite file. Set these before deployment.
# DATABASE_URL=postgresql://user:password@host:5432/sahayak
# JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=10080
OTP_DEMO_MODE=true
OTP_DEMO_CODE=624251

# Knowledge-admin dashboard. Store an Argon2id hash, never the plaintext
# password. Generate it inside your secret manager or a secure shell.
ADMIN_ID=admin1234
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$replace-with-a-real-salt$replace-with-a-real-hash
ADMIN_ACCESS_TOKEN_MINUTES=240

# LiveKit Agent configuration
AGENT_NAME=vyamit-voice

# Google Cloud STT Configuration
GOOGLE_STT_LANGUAGE=hi-IN
GOOGLE_STT_MODEL=latest_long
GOOGLE_STT_LOCATION=global
GOOGLE_KEYTERMS=Vyamit
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_TTS_LANGUAGE=en
CARTESIA_TTS_SPEED=1.0

# Enable only for LiveKit Cloud projects with AI Coustics available.
ENABLE_ENHANCED_NOISE_CANCELLATION=false
