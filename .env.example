# Root level .env.example - Copy to .env and fill in your actual values

# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Google Cloud Configuration (for STT/TTS/Gemini)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account-key.json
GOOGLE_STT_LANGUAGE=hi-IN
GOOGLE_STT_MODEL=latest_long
GOOGLE_STT_LOCATION=global
GOOGLE_KEYTERMS=Sahayak,सहायक,नमस्ते,धन्यवाद,सहकारी,पीएसीएस
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.35

# Verified Knowledge Engine (backend-only; never put these in frontend/.env).
# QDRANT_URL may be an internal HTTPS endpoint. QDRANT_API_KEY is optional only
# for deployments that protect Qdrant with an API key.
QDRANT_URL=https://your-internal-qdrant.example
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=sahayak_verified_knowledge
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-004

# Cartesia TTS Configuration
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_TTS_LANGUAGE=en
CARTESIA_TTS_SPEED=1.0

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agent Configuration
AGENT_NAME=sahayak-ai
ENABLE_ENHANCED_NOISE_CANCELLATION=false

# Sahayak mobile authentication — server-only values
# Use a strong random JWT secret in every deployment. Never expose it in Vite.
APP_ENV=development
DATABASE_URL=postgresql://database-user:database-password@database-host:5432/database-name
JWT_SECRET_KEY=replace-with-a-long-random-server-secret
OTP_DEMO_MODE=true
# Demo OTP stays backend-only. Production startup refuses OTP_DEMO_MODE=true.
OTP_DEMO_CODE=624251
# Set OTP_DEMO_MODE=false and configure this provider key before production.
FAST2SMS_API_KEY=

# Optional device Face ID / biometric sign-in (WebAuthn passkeys).
# Use your public HTTPS origin and its registrable domain in production, e.g.
# WEB_AUTHN_RP_ID=app.example.in
# WEB_AUTHN_ORIGINS=https://app.example.in
# The browser/device retains biometric data; FastAPI stores only public keys.
WEB_AUTHN_RP_NAME=Sahayak AI
WEB_AUTHN_RP_ID=
WEB_AUTHN_ORIGINS=
