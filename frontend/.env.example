# Public browser configuration only. Do not put any provider or LiveKit secret here.
# 
# Local development: Leave VITE_API_BASE_URL empty. Vite will proxy /api requests
# to your local backend (http://127.0.0.1:8000).
#
# Production deployment: Set VITE_API_BASE_URL to your backend's full HTTPS URL.
# Examples:
#   VITE_API_BASE_URL=https://sahayak-api.onrender.com
#   VITE_API_BASE_URL=https://api.yourdomain.com
#
# Important: Do NOT include a trailing slash, and ensure it's HTTPS for production.
VITE_API_BASE_URL=

# Agent name displayed in the UI
VITE_AGENT_NAME=sahayak-ai
