# Sahayak AI — Raspberry Pi Physical Kiosk Configuration
#
# Only two things are required to connect this kiosk to the Sahayak AI system:
#
#   BACKEND_SERVER_URL  — IP/hostname of your FastAPI backend
#   LIVEKIT_AGENT_NAME  — must match the agent name registered on the backend
#
# All credentials (LiveKit keys, Google STT, API secrets) live on the backend.
# The kiosk holds no secrets — it is just a browser proxied through Flask.

# ── Backend Server ────────────────────────────────────────────────────────────
BACKEND_SERVER_URL=http://10.99.159.207:8000

# ── LiveKit Agent Name ────────────────────────────────────────────────────────
LIVEKIT_AGENT_NAME=sahayak-ai

# ── Camera (for OpenCV face recognition HUD) ──────────────────────────────────
# IMPORTANT: Set ENABLE_FACE_HUD=false (default) so the camera is free for the
# browser to use for document scanning via getUserMedia.
# Set to true ONLY if you have a second camera dedicated to face recognition.
# If both OpenCV and Chromium try to open the same camera, document scanning fails.
ENABLE_FACE_HUD=false
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# ── Kiosk Flask Server ────────────────────────────────────────────────────────
KIOSK_HOST=0.0.0.0
KIOSK_PORT=5000
