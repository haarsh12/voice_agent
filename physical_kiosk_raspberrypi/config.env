# Environment Configuration for Raspberry Pi Kiosk Hardware

# Backend Server IP Address (Configured for Friend's Laptop on Wi-Fi Network)
BACKEND_SERVER_URL=http://192.168.29.241:8000

# Google Credentials File Path
GOOGLE_APPLICATION_CREDENTIALS=project-d8fe05cb-90bb-4815-aca-c79b84dcbad5.json

# Audio ALSA Hardware Devices (Supports USB Mic & INMP441 I2S MEMS Mic)
ALSA_RECORD_DEVICE=plughw:CARD=sndrpigooglevoi,DEV=0
ALSA_PLAYBACK_DEVICE=plughw:CARD=sndrpigooglevoi,DEV=0
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
AUDIO_BIT_DEPTH=S32_LE

# Camera Hardware Specs
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Local Kiosk Server Specs
KIOSK_HOST=0.0.0.0
KIOSK_PORT=5000
