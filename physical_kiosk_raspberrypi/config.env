# ──────────────────────────────────────────────────────────────────────────────
# Sahayak AI — Raspberry Pi Physical Kiosk Configuration
# Copy this file to config.env and fill in your values.
# No credentials or API keys belong in this file — they live in the backend.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend Server ────────────────────────────────────────────────────────────
# IP address (or hostname) of the machine running the Sahayak AI FastAPI backend.
# Example: http://192.168.1.42:8000
BACKEND_SERVER_URL=http://192.168.29.241:8000

# ── LiveKit Agent Name ────────────────────────────────────────────────────────
# Must match the agent name registered with the backend LiveKit worker.
LIVEKIT_AGENT_NAME=sahayak-ai

# ── Google Cloud Credentials (for on-device STT only) ─────────────────────────
# Path to the service account JSON file (relative to this directory, or absolute).
# Only required for the hardware-mic → Google STT pipeline.
# The LiveKit voice session uses the backend's credentials, not these.
GOOGLE_APPLICATION_CREDENTIALS=project-d8fe05cb-90bb-4815-aca-c79b84dcbad5.json

# ── STT Default Language ──────────────────────────────────────────────────────
# Used for the hardware push-to-talk fallback STT pipeline.
# The LiveKit session language is controlled by the Chromium UI language selector.
STT_LANGUAGE=hi-IN

# ── ALSA Audio Devices ────────────────────────────────────────────────────────
# Run `aplay -l` and `arecord -l` on the Raspberry Pi to find your device names.
ALSA_RECORD_DEVICE=plughw:CARD=sndrpigooglevoi,DEV=0
ALSA_PLAYBACK_DEVICE=plughw:CARD=sndrpigooglevoi,DEV=0
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
AUDIO_BIT_DEPTH=S32_LE

# ── Camera ────────────────────────────────────────────────────────────────────
# Run `v4l2-ctl --list-devices` to find your camera index.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# ── Kiosk Flask Server ────────────────────────────────────────────────────────
KIOSK_HOST=0.0.0.0
KIOSK_PORT=5000
